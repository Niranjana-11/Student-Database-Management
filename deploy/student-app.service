[Unit]
Description=Student Management System (FastAPI)
After=network.target

[Service]
User=niranjana_rajesh
Group=niranjana_rajesh
WorkingDirectory=/home/niranjana_rajesh/FastAPI
EnvironmentFile=-/home/niranjana_rajesh/FastAPI/.env
ExecStart=/home/niranjana_rajesh/FastAPI/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target